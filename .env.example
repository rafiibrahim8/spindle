# Backend
PORT=3001
# Single root for persistent data — db lives at $DATA_ROOT/db/music.db,
# cached album art at $DATA_ROOT/art. Defaults to ./data when unset.
DATA_ROOT=./data
FRONTEND_URL=http://localhost:5174
DEFAULT_MUSIC_ROOT=

# Frontend (Vite)
VITE_API_BASE=/api
VITE_STREAM_BASE=
VITE_DEFAULT_MUSIC_ROOT=
